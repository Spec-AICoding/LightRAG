# Development environment configuration
VITE_BACKEND_URL=http://localhost:9621
VITE_API_PROXY=true
VITE_API_ENDPOINTS=/api,/documents,/graphs,/graph,/health,/query,/docs,/redoc,/openapi.json,/login,/auth-status,/static

# Magicbox backend (read-only graph retrieval service, port 9622).
# Used directly by src/api/magicbox.ts in dev; CORS on 9622 allows
# http://localhost:5174. In production builds the client falls back to the
# relative /magicbox prefix (route it to 9622 in your reverse proxy).
VITE_MAGICBOX_BACKEND_URL=http://localhost:9622

# Onyx gateway (onyx magicbox-backend, port 8090): connector configuration
# listing (src/api/onyx.ts). Left unset in dev so the client uses the
# same-origin /onyx prefix, which the Vite dev proxy forwards to 8090
# (no CORS needed on 8090). Production: route /onyx to the gateway in your
# reverse proxy, or set VITE_ONYX_GATEWAY_URL to the gateway origin.
# VITE_ONYX_GATEWAY_URL=
